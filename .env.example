# ARGO REDCap marketplace — environment template
#
# Copy this file to ~/.argo/.env (gitignored) and fill in real tokens:
#     cp .env.example ~/.argo/.env
#     $EDITOR ~/.argo/.env
# Source it before running ARGO skills:
#     set -a; source ~/.argo/.env; set +a
#
# Get a token in REDCap: API Playground / "API" link on each project (per-user, per-project).
# Each variable name below is the exact name the skills read — don't rename them.

# Your REDCap API endpoint
REDCAP_URL=https://redcap.oauife.edu.ng/api/

# --- Admin REDCaps (study-portfolio in argo-pm; redcap-build in argo-build) ---
# Read by name. STUDY_INITIATION_REQUEST is also the SIR token used by redcap-build.
STUDY_INITIATION_REQUEST=
STUDY_PERSONELL_REQUEST=
DATA_LINKING_REQUEST=
DATA_REQUEST=
SUPPORT_TICKET_REQUEST=

# --- Cohort & study REDCaps (argo-qa, argo-analysis) ---
# Convention: one <NAME>_TOKEN per project. Pass it to QA scripts via
#   --token-env CRC_TOKEN   (and reference it as $CRC_TOKEN in data exports).
# Add a line here for each project you work on.
CRC_TOKEN=
GASTRIC_TOKEN=
PROSTATE_TOKEN=
BREAST_TOKEN=
BREAST_CLIPS_TOKEN=
COLONOSCOPY_TOKEN=
COSTFIN_TOKEN=
CRC_TRANSITION_TOKEN=
HPB_TOKEN=
MDC_QUALITATIVE_TOKEN=
P20_AIM1_TOKEN=
PROSTATE_ED_TOKEN=
SARCOMA_TOKEN=
RA_TEST_TOKEN=

# --- Paths (edit to your local layout; ~ is expanded) ---
# Operational folders that live OUTSIDE this repo, on your machine.
ARGO_PM_ROOT=~/ARGO/REDCap/PM              # required by argo-pm/study-portfolio
ARGO_BUILDS_ROOT=~/ARGO/REDCap/Builds
ARGO_LINKAGES_ROOT=~/ARGO/REDCap/Linkages
